# Production Site URL
# Leave empty until a custom domain is live: Vercel's production address is used instead
NEXT_PUBLIC_SITE_URL=

# Form Handling & Email Notification
# RESEND_API_KEY is required in production; without it the form returns an error
# instead of accepting enquiries. In development, enquiries are only logged.
CONTACT_EMAIL_RECIPIENT=ceo.levexa@gmail.com
RESEND_API_KEY=
# Must use a domain verified in Resend. The default onboarding@resend.dev sender
# only delivers to the Resend account owner's own address.
CONTACT_EMAIL_FROM=Levexa Inquiries <enquiry@levexa.com>
